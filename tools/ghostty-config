# Theme
theme = catppuccin-mocha.conf

# Font
font-family = Monaspace Neon
font-family = BIZ UDGothic
font-feature = -dlig
font-size = 15

# Mac
macos-window-shadow = false

# Window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# Shell
shell-integration-features = no-cursor

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = true
cursor-opacity = 0.8

# Other
mouse-hide-while-typing = true
resize-overlay = never
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Keybind
# Send CSI-u for ctrl+enter; the default is a bare CR, which Claude Code cannot
# tell apart from a plain Enter.
keybind = ctrl+enter=text:\x1b[13;5u
# Option+left/right move by one word. `esc:` sends an ESC-prefixed sequence
# (the docs' own example is esc:d = M-d) and `opt` is an alias for `alt`;
# ESC b / ESC f are zsh's built-in backward-word / forward-word, so this keeps
# working inside tmux too (see tools/tmux/tmux.conf).
keybind = opt+left=esc:b
keybind = opt+right=esc:f
