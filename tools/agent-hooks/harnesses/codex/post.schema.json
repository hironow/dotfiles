{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "post-tool-use.command.input",
  "description": "Derived from Codex's generated codex-rs/hooks/schema/generated/post-tool-use.command.input.schema.json at rust-v0.166.0: the envelope is opened to unknown members, and tool_input is typed per tool (Bash, apply_patch). Codex fires PostToolUse when a call completes, with no success signal.",
  "definitions": {
    "NullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "CommandInput": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "PostToolUse",
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "permission_mode": {
      "enum": [
        "default",
        "acceptEdits",
        "plan",
        "dontAsk",
        "bypassPermissions"
      ],
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "tool_input": true,
    "tool_name": {
      "type": "string"
    },
    "tool_response": true,
    "tool_use_id": {
      "type": "string"
    },
    "transcript_path": {
      "$ref": "#/definitions/NullableString"
    },
    "turn_id": {
      "description": "Codex extension: expose the active turn id to internal turn-scoped hooks.",
      "type": "string"
    }
  },
  "required": [
    "cwd",
    "hook_event_name",
    "model",
    "permission_mode",
    "session_id",
    "tool_input",
    "tool_name",
    "tool_response",
    "tool_use_id",
    "transcript_path",
    "turn_id"
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "tool_name": {
            "const": "Bash"
          }
        },
        "required": [
          "tool_name"
        ]
      },
      "then": {
        "properties": {
          "tool_input": {
            "$ref": "#/definitions/CommandInput"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool_name": {
            "const": "apply_patch"
          }
        },
        "required": [
          "tool_name"
        ]
      },
      "then": {
        "properties": {
          "tool_input": {
            "$ref": "#/definitions/CommandInput"
          }
        }
      }
    }
  ],
  "x-ir-tool": "/tool_name",
  "x-ir": {
    "command": [
      "/tool_input/command"
    ],
    "filePath": [
      "/tool_input/file_path"
    ],
    "content": [
      "/tool_input/content",
      "/tool_input/new_string",
      "/tool_input/new_source"
    ],
    "cwd": [
      "/cwd"
    ]
  },
  "x-ir-undeclared": {
    "description": "Pointers x-ir reads though Codex never sends them: the old guards read the same fields for every harness, and the port keeps that.",
    "pointers": [
      "/tool_input/file_path",
      "/tool_input/content",
      "/tool_input/new_string",
      "/tool_input/new_source"
    ]
  }
}
