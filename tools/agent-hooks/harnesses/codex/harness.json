{
  "name": "codex",
  "versions": [
    "0.166.0"
  ],
  "tools": {
    "Bash": "shell",
    "apply_patch": "patch"
  },
  "transport": "command",
  "pathResolution": "as-given",
  "hookCwd": "session",
  "support": {
    "command-guard": {
      "Bash": {
        "level": "supported"
      }
    },
    "files-guard": {
      "apply_patch": {
        "level": "supported"
      }
    },
    "secrets-guard": {
      "apply_patch": {
        "level": "supported"
      }
    },
    "rtk": {
      "Bash": {
        "level": "supported"
      }
    },
    "formatter": {
      "apply_patch": {
        "level": "supported"
      }
    }
  },
  "events": {
    "pre": {
      "schema": "pre.schema.json",
      "answers": {
        "pass": {
          "exit": 0
        },
        "block": {
          "exit": 0,
          "stdoutJSON": {
            "hookSpecificOutput": {
              "hookEventName": "PreToolUse",
              "permissionDecision": "deny",
              "permissionDecisionReason": "{{oneLine .Message}}"
            }
          }
        },
        "forward": {
          "exit": 0,
          "stdout": "{{.Native}}\n"
        }
      }
    },
    "post": {
      "schema": "post.schema.json",
      "answers": {
        "pass": {
          "exit": 0,
          "stderr": "{{.Notice}}"
        }
      }
    }
  }
}
