{
  "name": "codex",
  "versions": [
    "0.166.0"
  ],
  "tools": {
    "Bash": "shell",
    "apply_patch": "patch"
  },
  "transport": "command",
  "pathResolution": "as-given",
  "hookCwd": "session",
  "support": {
    "command-guard": {
      "Bash": {
        "level": "supported",
        "os": {
          "windows": {
            "level": "degraded",
            "reason": "Codex runs PowerShell on Windows; the guard reads its text with bash grammar (PR 2e.4)"
          }
        }
      }
    },
    "files-guard": {
      "apply_patch": {
        "level": "supported"
      }
    },
    "secrets-guard": {
      "apply_patch": {
        "level": "supported"
      }
    },
    "rtk": {
      "Bash": {
        "level": "supported"
      }
    },
    "formatter": {
      "apply_patch": {
        "level": "supported"
      }
    }
  },
  "registration": {
    "events": {"pre": "PreToolUse", "post": "PostToolUse"},
    "blocks": [
      {"event": "pre", "matcher": "Write|Edit|NotebookEdit", "hooks": ["files-guard", "secrets-guard"]},
      {"event": "pre", "matcher": "Bash", "hooks": ["command-guard"]},
      {"event": "pre", "matcher": "Bash", "hooks": ["rtk"]},
      {"event": "post", "matcher": "Write|Edit", "hooks": ["formatter"]}
    ],
    "launchers": [
      {
        "os": ["darwin", "linux"], "shell": "sh",
        "closed": {"type": "command", "command": "{{sh .Binary}} {{.Harness}} {{.Event}} --hook {{.Hook}} || { printf '%s\\n' 'agent-hook failed' >&2; exit 2; }", "timeout": 30},
        "open": {"type": "command", "command": "{{sh .Binary}} {{.Harness}} {{.Event}} --hook {{.Hook}}", "timeout": 30}
      },
      {
        "os": ["windows"], "shell": "powershell",
        "closed": {"type": "command", "command": "& {{powershell .Binary}} {{.Harness}} {{.Event}} --hook {{.Hook}}; if ($LASTEXITCODE -ne 0) { '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"agent-hook failed\"}}' }", "timeout": 30},
        "open": {"type": "command", "command": "& {{powershell .Binary}} {{.Harness}} {{.Event}} --hook {{.Hook}}", "timeout": 30}
      },
      {
        "os": ["windows"], "shell": "cmd",
        "closed": {"type": "command", "command": "{{cmd .Binary}} {{.Harness}} {{.Event}} --hook {{.Hook}} || echo {\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"agent-hook failed\"}}", "timeout": 30},
        "open": {"type": "command", "command": "{{cmd .Binary}} {{.Harness}} {{.Event}} --hook {{.Hook}}", "timeout": 30}
      }
    ]
  },
  "events": {
    "pre": {
      "schema": "pre.schema.json",
      "answers": {
        "pass": {
          "exit": 0
        },
        "block": {
          "exit": 0,
          "stdoutJSON": {
            "hookSpecificOutput": {
              "hookEventName": "PreToolUse",
              "permissionDecision": "deny",
              "permissionDecisionReason": "{{oneLine .Message}}"
            }
          }
        },
        "forward": {
          "exit": 0,
          "stdout": "{{.Native}}\n"
        }
      }
    },
    "post": {
      "schema": "post.schema.json",
      "answers": {
        "pass": {
          "exit": 0,
          "stderr": "{{.Notice}}"
        }
      }
    }
  }
}
