#!/usr/bin/env bash
# ax-exec: run one command in an existing AX task (Phase 6 plan D12; what
# cdr-exec was for Coder).
#
#   ax-exec NAME [--timeout 30m] [--claude] -- CMD...
#
# 1. The lease must still run for --timeout plus 5 minutes (exe-reaper
#    may-start).
# 2. A Suspended task is resumed and waited for, Running, for at most 10
#    minutes.
# 3. The lease is checked again right before the launch.
# 4. CMD runs detached in the task and is followed by short `ax ssh` polls,
#    as in ax-job; its exit code is ax-exec's.
# 5. A task ax-exec resumed is suspended again afterwards, so a finished
#    command never keeps the node awake; one it found Running is left Running.
#    It never deletes a task.
#
# --claude works as in ax-job (plan Q20).
#
# Exit: the command's own code, or 2 (usage), 3 (the lease said not now), 69
# (the task stopped answering), 75 (the task was suspended mid-command, as a
# drain does), 124 (timed out; its process group killed), 1 (anything else).

set -euo pipefail
AX_TOOL=ax-exec
# shellcheck source=exe/scripts/ax-lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/ax-lib.sh"

usage="usage: ax-exec NAME [--timeout 30m] [--claude] -- CMD..."
name="${1:-}"
[[ -n "$name" && "$name" != -* ]] || usage_error "$usage"
shift
timeout="30m" claude=0
while (($#)); do
	case "$1" in
	--timeout)
		(($# >= 2)) || usage_error "--timeout needs a value; $usage"
		timeout="$2"
		shift 2
		;;
	--claude)
		claude=1
		shift
		;;
	--)
		shift
		break
		;;
	*) usage_error "unexpected $1; $usage" ;;
	esac
done
(($#)) || usage_error "no command after --; $usage"
timeout_s="$(seconds "$timeout")" || usage_error "--timeout $timeout: use 90s, 30m or 2h"

need=$((timeout_s + 300))
may_start "$need" || exit $?

# Whether to suspend the task again on the way out: only one ax-exec resumed,
# and not after a drain suspended it or when it cannot be reached.
restore=0
# shellcheck disable=SC2329 # run by the EXIT trap below
cleanup() {
	if ((restore)) && ! ax suspend task "$name" -a "$AX_ATESPACE" >/dev/null 2>&1; then
		log "could not suspend task $name again: ax suspend task $name -a $AX_ATESPACE"
	fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM

if ((claude)); then
	read_claude_token || exit 1
fi

phase="$(task_phase "$name")" || die "cannot list the tasks in $AX_ATESPACE"
case "$phase" in
Running) ;;
Pending) wait_running "$name" || exit 1 ;;
Suspended)
	ax resume task "$name" -a "$AX_ATESPACE" >&2 || die "ax resume failed"
	restore=1
	wait_running "$name" || exit 1
	;;
"") die "no task named $name in $AX_ATESPACE" ;;
*) die "task $name is $phase: ax describe task $name -a $AX_ATESPACE" ;;
esac
may_start "$need" || exit $?

rc=0
run_detached "$name" "$timeout_s" "$@" || rc=$?
if ((rc == EXIT_SUSPENDED || rc == EXIT_UNREACHABLE)); then
	restore=0
fi
exit "$rc"
