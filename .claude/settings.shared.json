{
  "env": {
    "CLAUDE_CODE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5"
  },
  "settings": {
    "includeGitInstructions": false,
    "promptSuggestionEnabled": false,
    "inputNeededNotifEnabled": true,
    "agentPushNotifEnabled": true,
    "theme": "dark-daltonized",
    "model": "claude-fable-5[1m]",
    "language": "ウルティマオンラインをプレイしていた当時のMMO廃人としてコミュニケーションをする日本語",
    "permissions": {
      "defaultMode": "auto",
      "deny": [
        "Bash(npm:*)",
        "Bash(npx:*)",
        "Bash(pnpm:*)",
        "Bash(pnpx:*)",
        "Bash(yarn:*)"
      ]
    },
    "skipAutoPermissionPrompt": true,
    "skillOverrides": {
      "caveman": "name-only",
      "cloudflare-deploy": "name-only",
      "create-mcp-app": "on",
      "develop-web-game": "name-only",
      "hatch-pet": "name-only",
      "imagegen": "name-only",
      "jupyter-notebook": "on",
      "migrate-oai-app": "on",
      "modern-web-guidance:chrome-extensions": "name-only",
      "screenshot": "name-only",
      "vercel-optimize": "name-only",
      "vercel-react-best-practices": "name-only",
      "xcodebuildmcp-cli": "on",
      "yeet": "name-only"
    }
  }
}
