# Copy to terraform.tfvars (gitignored) and fill in. Nothing here is a secret,
# but the value identifies a private thing, so it stays out of the repo.

# The tailnet's name as the Tailscale API knows it; "-" means the API key's own.
tailnet = "-"

# The state's bucket and prefix are in main.tf, and its passphrase comes from
# ~/.config/tofu/tailnet.passphrase through TF_ENCRYPTION (just _tailnet-encryption).
# Neither belongs here.
