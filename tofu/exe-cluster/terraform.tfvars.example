# Copy to terraform.tfvars (gitignored), mode 0600, and fill in. Nothing in this
# example may be a real value.

# The private project (the same two values exe-platform's tfvars carry).
gcp_project_id     = "REPLACE-project-id"
gcp_project_number = "000000000000"

# The KMS key this stack's state is encrypted with:
#   cd tofu/exe-platform && tofu output -raw state_kms_key
state_kms_key = "projects/REPLACE-project-id/locations/asia-northeast1/keyRings/exe-state/cryptoKeys/exe-cluster-state"

# The gVisor worker image, as `just exe-worker-images` prints it (ateom-gvisor).
# Leave unset until then: empty means no WorkerPool. A tag is refused.
# ateom_gvisor_image = "REPLACE-region-docker.pkg.dev/REPLACE-project-id/exe-platform/substrate/ateom-gvisor-REPLACE@sha256:REPLACE-64-hex-digest"

# The Gemini key AX hands to tasks. Unset means no Secret. Operator only; never
# in a tracked file, a chat or a report.
# gemini_api_key = "REPLACE"
